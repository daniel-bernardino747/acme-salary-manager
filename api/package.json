{
  "name": "@acme/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput --env-file dev.env",
    "build": "nest build -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed/main.js",
    "start:prod": "node dist/migrate.js && node dist/seed/main.js --if-empty && node dist/main.js",
    "perf": "node dist/perf/main.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@acme/contract": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "on-headers": "1.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.16.18",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/on-headers": "1.0.4",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "5.0.4"
  }
}
