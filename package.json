{
  "name": "acme-salary-manager",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm --filter @acme/contract build && pnpm -r --if-present run typecheck",
    "test": "pnpm --filter @acme/contract build && pnpm -r --if-present run test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "start": "pnpm --filter @acme/api run start:prod"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
